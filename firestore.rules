rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Phase 3: Primitives & Global Helpers
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isAnalyst() { return hasRole('analyst'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Phase 4: Collection Rules
    // ---------------------------------------------------------

    // USERS
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'full_name', 'document_type', 'document_number', 'email', 'role'])
          && data.uid == userId
          && data.full_name is string && data.full_name.size() <= 200
          && data.document_type is string && data.document_type.size() <= 10
          && data.document_number is string && data.document_number.size() <= 30
          && data.email is string && data.email.size() <= 200
          && data.role in ['user', 'analyst', 'admin'];
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || isAnalyst());
      allow list: if isAdmin() || isAnalyst();
      
      allow create: if isSignedIn() 
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'user'; // Users can only self-register as 'user'
      
      allow update: if isSignedIn() && (
        // Admin can change anything
        (isAdmin() && isValidUser(incoming())) ||
        // User can update phone or email but NOT role
        (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role)
      );
      
      allow delete: if isAdmin();
    }

    // NEWS
    match /news/{newsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /enrollments/{enrollmentId} {
        allow read: if isSignedIn() && (isAdmin() || isAnalyst() || isOwner(incoming().user_id));
        allow list: if isAdmin() || isAnalyst();
        allow create: if isSignedIn() && isOwner(incoming().user_id);
        allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().user_id));
      }
    }

    // SURVEYS
    match /surveys/{surveyId} {
      function isValidSurvey(data) {
        return data.keys().hasAll(['user_id', 'status'])
          && data.user_id is string && data.user_id.size() <= 128
          && data.status in ['pending_start', 'draft', 'pending', 'approved', 'rejected', 'rejected_final'];
      }

      allow get: if isSignedIn() && (isOwner(existing().user_id) || isAdmin() || isAnalyst());
      allow list: if isAdmin() || isAnalyst() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      
      allow create: if isSignedIn() 
        && isValidSurvey(incoming())
        && isOwner(incoming().user_id)
        && incoming().status == 'draft';

      allow update: if isSignedIn() && (
        (isAdmin() && isValidSurvey(incoming())) ||
        (isAnalyst() && isValidSurvey(incoming())) ||
        (isOwner(existing().user_id) && isValidSurvey(incoming()) && (
          // Action: Save Draft
          (incoming().status == 'draft' && existing().status == 'draft') ||
          // Action: Submit for review
          (incoming().status == 'pending' && existing().status in ['draft', 'rejected'])
        ))
      );

      // HISTORY & REVIEWS
      match /history/{id} {
        allow read: if isSignedIn() && (isAdmin() || isAnalyst() || isOwner(get(/databases/$(database)/documents/surveys/$(surveyId)).data.user_id));
        allow create: if isSignedIn(); // Logged by client, but we should strictly check fields
      }
      match /reviews/{id} {
        allow read: if isSignedIn() && (isAdmin() || isAnalyst() || isOwner(get(/databases/$(database)/documents/surveys/$(surveyId)).data.user_id));
        allow create: if isAdmin() || isAnalyst();
      }
    }

    // DOCUMENTS
    match /documents/{documentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.user_id) || isAdmin() || isAnalyst());
      allow create: if isSignedIn() && isOwner(incoming().user_id);
      allow update: if isAdmin() || isAnalyst();
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().user_id));
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(resource.data.user_id);
      allow create: if isAdmin() || isAnalyst();
      allow update: if isSignedIn() && isOwner(resource.data.user_id) && incoming().diff(existing()).affectedKeys().hasOnly(['is_read']);
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if true; // Public configs (e.g. policy URL)
      allow write: if isAdmin();
    }
  }
}
