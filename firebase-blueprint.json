{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "full_name": { "type": "string" },
        "document_type": { "type": "string" },
        "document_number": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "analyst", "admin"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "full_name", "document_type", "document_number", "email", "role"]
    },
    "News": {
      "title": "News",
      "description": "Educational or institutional news",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image_url": { "type": "string" },
        "category": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "is_active"]
    },
    "Event": {
      "title": "Event",
      "description": "Workshops, brigades or activities",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "capacity": { "type": "number" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "date", "location", "is_active"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "User enrollment in an event",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "event_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "event_id"]
    },
    "Survey": {
      "title": "Survey",
      "description": "Socio-demographic characterization survey",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_start", "draft", "pending", "approved", "rejected", "rejected_final"] },
        "current_step": { "type": "number" },
        "habeas_data_accepted": { "type": "boolean" },
        "answers": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "status"]
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "Uploaded files by users",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "type": { "type": "string" },
        "file_path": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "type", "file_path", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "title", "message", "is_read"]
    },
    "Review": {
      "title": "Review",
      "description": "Survey review record",
      "type": "object",
      "properties": {
        "survey_id": { "type": "string" },
        "analyst_id": { "type": "string" },
        "status": { "type": "string" },
        "observations": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["survey_id", "analyst_id", "status"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Audit log for surveys",
      "type": "object",
      "properties": {
        "survey_id": { "type": "string" },
        "user_id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["survey_id", "user_id", "action"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application setting",
      "type": "object",
      "properties": {
        "value": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "System news and articles"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Community events"
    },
    "/events/{eventId}/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Event enrollments"
    },
    "/surveys/{surveyId}": {
      "schema": "Survey",
      "description": "Characterization surveys"
    },
    "/documents/{documentId}": {
      "schema": "UserDocument",
      "description": "Uploaded identification or support documents"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notifications"
    },
    "/surveys/{surveyId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Review history for a survey"
    },
    "/surveys/{surveyId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "Audit trail for a survey"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "App settings like policy PDFs"
    }
  }
}
